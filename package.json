{
  "name": "falcon-ai",
  "version": "1.0.0",
  "description": "Executive email assistant - monitors an IONOS inbox, notifies via WhatsApp, drafts and sends replies only with explicit approval.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/index.js",
    "check": "node scripts/check.js",
    "test": "node --test"
  },
  "keywords": [
    "email",
    "whatsapp",
    "imap",
    "smtp",
    "openrouter",
    "bullmq",
    "assistant"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.23",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "imapflow": "^1.0.160",
    "ioredis": "^5.4.1",
    "mailparser": "^3.7.1",
    "mongoose": "^8.8.0",
    "nodemailer": "^6.9.16",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  }
}
