# =========================================================
# Falcon AI - Environment Variables
# Copy to .env and fill in real values.
# =========================================================

# --- Runtime -------------------------------------------------
NODE_ENV=development
PORT=3000

# Set true to run workers inside the API process (single process dev mode)
ENABLE_WORKERS=true
# Used by the dedicated PM2 worker process (npm run worker). Leave false in API process.
WORKER_ROLE=false

# --- MongoDB ---------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/falcon_ai

# --- Redis (used by BullMQ) -------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- IONOS IMAP (incoming mail) ---------------------------------
# IONOS addresses: imap.ionos.com (TLS 993) / smtp.ionos.com (SSL 465)
IMAP_HOST=imap.ionos.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@your-domain.com
IMAP_PASSWORD=your-imap-password
IMAP_MAILBOX=INBOX

# --- IONOS SMTP (outgoing mail) ---------------------------------
SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@your-domain.com
SMTP_PASSWORD=your-smtp-password
# From-name shown on outgoing replies
SENDER_NAME=Falcon AI
# Signature appended to every draft (use \n for line breaks)
SIGNATURE=Best regards,\nFalcon AI

# --- OpenRouter (AI) --------------------------------------------
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=https://falcon.local
OPENROUTER_APP_NAME=Falcon AI

# --- WhatsApp ---------------------------------------------------
# Provider: "baileys" (scan QR with your phone, no Meta app/token) or "cloud" (WhatsApp Cloud API).
# For "baileys" you only need WHATSAPP_RECIPIENT. Cloud API credentials below are optional then.
WHATSAPP_PROVIDER=baileys
# Admin WhatsApp number that receives notifications and sends SEND/EDIT/CANCEL.
# Format: country code + number, no '+' or spaces, e.g. 4917012345678
WHATSAPP_RECIPIENT=4917012345678
# Only required when WHATSAPP_PROVIDER=cloud
WHATSAPP_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=change-me-random-string
WHATSAPP_API_VERSION=v21.0
# Only used by the cloud provider webhook. Public HTTPS URL, no trailing slash.
WEBHOOK_PUBLIC_URL=

# --- Inbox polling ----------------------------------------------
POLL_INTERVAL_MS=60000
POLL_MAX_FETCH=100
FIRST_RUN_MAX_FETCH=20

# --- Attachments ------------------------------------------------
UPLOAD_DIR=uploads
